# SKYBRIDGE console environment (read-only; no secrets).
# Control plane base URL (no trailing slash).
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:18080
# Advisory AI service base URL (GET only; panel shows unavailable when down).
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:18082
# Optional pinned IDs for the local demo (dashboard auto-discovers when empty).
NEXT_PUBLIC_WORKLOAD_ID=
NEXT_PUBLIC_MIGRATION_ID=
# Console port (default 3000).
PORT=3000
